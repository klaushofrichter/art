{
  "name": "art",
  "private": true,
  "description": "Art gallery site for Klaus Hofrichter, served at art.klaushofrichter.net by Express on Knative/k3s.",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:fixtures": "ASSETS_DIR=$PWD/test/fixtures/assets tsx src/server.ts"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
