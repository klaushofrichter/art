{
  // The Playwright specs and their config. Their page.evaluate callbacks run
  // in the browser, so this adds the DOM types the server's build leaves out.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [".", "../playwright.config.ts"]
}
